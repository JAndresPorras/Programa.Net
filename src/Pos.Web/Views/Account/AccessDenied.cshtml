@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Acceso denegado";
}
<div class="login-shell" style="grid-template-columns:1fr;max-width:520px">
    <section class="login-form text-center">
        <div class="mx-auto mb-3" style="width:64px;height:64px;border-radius:50%;background:var(--danger-light);display:grid;place-items:center">
            <svg class="icon icon-xl" style="color:var(--danger)"><use href="#i-shield"></use></svg>
        </div>
        <h1>No tiene permiso</h1>
        <p class="lead-sm">
            Su usuario no cuenta con el permiso necesario para abrir esta pantalla.
            Solicite el acceso al administrador del sistema.
        </p>
        <a class="btn btn-primary login-btn" href="@(ViewBag.HomeUrl ?? Url.Action("Index", "Pos"))">
            <svg class="icon"><use href="#i-back"></use></svg> Volver al inicio
        </a>
    </section>
</div>
