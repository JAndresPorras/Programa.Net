@model CashSession
@{
    var c = (CurrencyInfo)ViewBag.Currency;
    var summary = (CashSessionSummary)ViewBag.Summary;
    var step = c.Decimals == 0 ? "1" : "0.01";
}

<div class="page-head">
    <div>
        <h1>Cierre y entrega de caja</h1>
        <p>Cuente el efectivo del cajón. El sistema calcula la diferencia y cuánto hay que entregarle al dueño.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-soft" asp-action="Index">
            <svg class="icon"><use href="#i-back"></use></svg> Volver
        </a>
    </div>
</div>

<form asp-action="Close" method="post" id="closeForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="row g-3">
        <!-- ---------------------------------------------- Conteo del efectivo -->
        <div class="col-lg-5">
            <div class="card-x mb-3">
                <div class="card-x__head">
                    <svg class="icon" style="color:var(--primary)"><use href="#i-coins"></use></svg>
                    <h2 class="card-x__title">Conteo del efectivo (arqueo)</h2>
                </div>
                <div class="card-x__body">
                    <p class="fs-12 text-soft mb-3">
                        Escriba cuántos billetes y monedas de cada valor hay en el cajón.
                        El total se calcula solo.
                    </p>

                    <table class="table-x" style="font-size:13px">
                        <thead>
                        <tr>
                            <th>Denominación</th>
                            <th class="t-center" style="width:90px">Cantidad</th>
                            <th class="t-right">Subtotal</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var denomination in c.Denominations)
                        {
                            <tr>
                                <td class="money">@c.Format(denomination)</td>
                                <td class="t-center">
                                    <input type="number" class="form-control form-control-sm denom-qty text-center"
                                           min="0" step="1" value="0" data-value="@denomination"
                                           aria-label="Cantidad de @c.Format(denomination)" />
                                </td>
                                <td class="t-right money denom-sub">@c.Format(0)</td>
                            </tr>
                        }
                        </tbody>
                    </table>

                    <div class="divider"></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-13">Total contado</span>
                        <b class="money" style="font-size:22px" id="denomTotal">@c.Format(0)</b>
                    </div>
                    <button type="button" class="btn btn-soft w-100 mt-2" id="btnUseCount">
                        <svg class="icon"><use href="#i-check"></use></svg> Usar este total
                    </button>
                </div>
            </div>
        </div>

        <!-- ---------------------------------------------- Resumen y entrega -->
        <div class="col-lg-7">
            <div class="card-x mb-3">
                <div class="card-x__head">
                    <svg class="icon" style="color:var(--info)"><use href="#i-chart"></use></svg>
                    <h2 class="card-x__title">Resumen del turno</h2>
                </div>
                <div class="card-x__body">
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-soft">Fondo inicial</span><b class="money">@c.Format(summary.OpeningAmount)</b>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-soft">Ventas en efectivo (@summary.SalesCount recibos)</span>
                        <b class="money text-success">+@c.Format(summary.CashSales)</b>
                    </div>
                    @if (summary.MovementsIn > 0)
                    {
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-soft">Otros ingresos</span>
                            <b class="money text-success">+@c.Format(summary.MovementsIn)</b>
                        </div>
                    }
                    @if (summary.MovementsOut > 0)
                    {
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-soft">Retiros</span>
                            <b class="money text-danger">-@c.Format(summary.MovementsOut)</b>
                        </div>
                    }
                    <div class="divider"></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-uppercase fs-12 text-soft">Debe haber en el cajón</span>
                        <b class="money" style="font-size:24px" id="expectedAmount"
                           data-value="@summary.ExpectedCash.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            @c.Format(summary.ExpectedCash)
                        </b>
                    </div>

                    @if (summary.CardSales + summary.TransferSales + summary.OtherSales > 0)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <svg class="icon"><use href="#i-info"></use></svg>
                            <div>
                                Además se cobraron
                                <b>@c.Format(summary.CardSales + summary.TransferSales + summary.OtherSales)</b>
                                por tarjeta o transferencia. Ese dinero no está en el cajón.
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card-x">
                <div class="card-x__head">
                    <svg class="icon" style="color:var(--success)"><use href="#i-cash"></use></svg>
                    <h2 class="card-x__title">Entrega del dinero</h2>
                </div>
                <div class="card-x__body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="countedAmount">Efectivo contado en el cajón</label>
                            <div class="input-group">
                                <span class="input-group-text">@c.Symbol</span>
                                <input type="number" class="form-control received-input" id="countedAmount"
                                       name="countedAmount" min="0" step="@step" value="0" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="leftInDrawer">Sencillo que queda para mañana</label>
                            <div class="input-group">
                                <span class="input-group-text">@c.Symbol</span>
                                <input type="number" class="form-control received-input" id="leftInDrawer"
                                       name="leftInDrawer" min="0" step="@step"
                                       value="@summary.OpeningAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="change-box" id="diffBox">
                                <span id="diffLabel">Diferencia</span>
                                <b id="diffValue">@c.Format(0)</b>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="change-box">
                                <span>Entregar al dueño</span>
                                <b id="deliverValue">@c.Format(0)</b>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="notes">Observaciones del cierre</label>
                        <textarea class="form-control" id="notes" name="notes" rows="2"
                                  placeholder="Ej. faltó sencillo por un vuelto"></textarea>
                    </div>
                </div>
                <div class="card-x__foot d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-fill"
                            data-confirm="¿Confirma el cierre de la caja? Después no podrá registrar más ventas en este turno.">
                        <svg class="icon"><use href="#i-check-circle"></use></svg> Cerrar caja y generar entrega
                    </button>
                    <a class="btn btn-soft" asp-action="Index">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var decimals = @c.Decimals;
            var symbol = '@c.Symbol';
            var expected = parseFloat(document.getElementById('expectedAmount').dataset.value || '0');

            function money(v) {
                var parts = Number(v || 0).toFixed(decimals).split('.');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                return symbol + ' ' + parts.join('.');
            }

            var qtyInputs = document.querySelectorAll('.denom-qty');
            var denomTotalEl = document.getElementById('denomTotal');
            var counted = document.getElementById('countedAmount');
            var left = document.getElementById('leftInDrawer');
            var diffBox = document.getElementById('diffBox');
            var diffLabel = document.getElementById('diffLabel');
            var diffValue = document.getElementById('diffValue');
            var deliverValue = document.getElementById('deliverValue');

            function recalcDenominations() {
                var total = 0;
                qtyInputs.forEach(function (input, index) {
                    var value = parseFloat(input.dataset.value || '0');
                    var qty = parseInt(input.value || '0', 10);
                    if (isNaN(qty) || qty < 0) { qty = 0; }
                    var sub = value * qty;
                    total += sub;
                    input.closest('tr').querySelector('.denom-sub').textContent = money(sub);
                });
                denomTotalEl.textContent = money(total);
                return total;
            }

            function recalcDelivery() {
                var countedValue = parseFloat(counted.value || '0');
                var leftValue = parseFloat(left.value || '0');

                var difference = countedValue - expected;
                diffLabel.textContent = difference > 0 ? 'Sobrante'
                                      : difference < 0 ? 'Faltante' : 'Diferencia';
                diffValue.textContent = money(Math.abs(difference));
                diffBox.classList.toggle('is-short', difference < 0);

                deliverValue.textContent = money(Math.max(0, countedValue - leftValue));
            }

            qtyInputs.forEach(function (input) {
                input.addEventListener('input', recalcDenominations);
                input.addEventListener('focus', function () { input.select(); });
            });

            document.getElementById('btnUseCount').addEventListener('click', function () {
                counted.value = recalcDenominations().toFixed(decimals);
                recalcDelivery();
                window.posToast('Total del conteo aplicado.', 'success');
            });

            counted.addEventListener('input', recalcDelivery);
            left.addEventListener('input', recalcDelivery);

            recalcDenominations();
            recalcDelivery();
        })();
    </script>
}
