@model Sale
@{
    Layout = null;
    var c = (CurrencyInfo)ViewBag.Currency;
    var s = (PosSettings)ViewBag.Settings;
    var auto = (bool)ViewBag.Auto;
    var copies = (int)ViewBag.Copies;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recibo @Model.Number</title>
    <style>
        /* Recibo para impresora térmica de 80 mm (área imprimible ≈ 72 mm) */
        @@page { size: 80mm auto; margin: 0; }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 4mm 3mm;
            width: 80mm;
            background: #fff;
            color: #000;
            font-family: "Consolas", "Courier New", monospace;
            font-size: 11.5px;
            line-height: 1.38;
            -webkit-print-color-adjust: exact;
        }

        .r-center { text-align: center; }
        .r-right  { text-align: right; }
        .r-bold   { font-weight: 700; }

        .r-shop { font-size: 15px; font-weight: 700; letter-spacing: .02em; margin-bottom: 2px; }
        .r-shop-info { font-size: 10.5px; }

        .r-sep { border-top: 1px dashed #000; margin: 5px 0; }
        .r-sep--solid { border-top: 1.5px solid #000; margin: 5px 0; }

        .r-doc { font-size: 13px; font-weight: 700; text-align: center; margin: 3px 0; }

        .r-meta { display: flex; justify-content: space-between; font-size: 10.5px; }

        table { width: 100%; border-collapse: collapse; }
        th { font-size: 10px; text-align: left; border-bottom: 1px solid #000;
             padding-bottom: 2px; text-transform: uppercase; }
        td { padding: 1.5px 0; vertical-align: top; font-size: 11px; }
        .col-q { width: 12%; }
        .col-p { width: 24%; text-align: right; }
        .col-t { width: 26%; text-align: right; }
        .item-name { padding-top: 3px; }

        .r-totals { margin-top: 4px; }
        .r-line { display: flex; justify-content: space-between; font-size: 11.5px; padding: 1px 0; }
        .r-total { display: flex; justify-content: space-between; font-size: 16px; font-weight: 700;
                   border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; padding: 3px 0; margin: 4px 0; }
        .r-change { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; }

        .r-foot { text-align: center; font-size: 10.5px; margin-top: 7px; }
        .r-void { text-align: center; border: 2px solid #000; padding: 4px; margin: 6px 0;
                  font-weight: 700; font-size: 13px; letter-spacing: .1em; }

        .r-cut { page-break-after: always; }
        .r-copy { text-align: center; font-size: 9.5px; margin-top: 4px; }

        .screen-bar {
            width: 80mm; margin: 14px auto; display: flex; gap: 8px; justify-content: center;
            font-family: "Segoe UI", system-ui, sans-serif;
        }
        .screen-bar button, .screen-bar a {
            flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;
            background: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
            text-align: center; color: #0f172a; text-decoration: none;
        }
        .screen-bar .primary { background: #2563eb; border-color: #2563eb; color: #fff; }

        @@media print {
            .screen-bar { display: none !important; }
            body { padding: 0 3mm; }
        }
        @@media screen {
            body { box-shadow: 0 0 0 1px #e2e8f0; margin: 14px auto; }
            html { background: #f1f5f9; }
        }
    </style>
</head>
<body>
@for (var copy = 1; copy <= copies; copy++)
{
    <div class="@(copy < copies ? "r-cut" : "")">
        <div class="r-center">
            <div class="r-shop">@s.BusinessName</div>
            @if (!string.IsNullOrWhiteSpace(s.BusinessDocument))
            {
                <div class="r-shop-info">@s.BusinessDocument</div>
            }
            @if (!string.IsNullOrWhiteSpace(s.BusinessAddress))
            {
                <div class="r-shop-info">@s.BusinessAddress</div>
            }
            @if (!string.IsNullOrWhiteSpace(s.BusinessPhone))
            {
                <div class="r-shop-info">Tel. @s.BusinessPhone</div>
            }
        </div>

        <div class="r-sep"></div>
        <div class="r-doc">RECIBO @Model.Number</div>
        <div class="r-sep"></div>

        <div class="r-meta"><span>Fecha</span><span>@Model.SoldAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
        <div class="r-meta"><span>Atendió</span><span>@Model.UserName</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.CustomerName))
        {
            <div class="r-meta"><span>Cliente</span><span>@Model.CustomerName</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CustomerDocument))
        {
            <div class="r-meta"><span>Documento</span><span>@Model.CustomerDocument</span></div>
        }

        @if (Model.Status == SaleStatus.Cancelled)
        {
            <div class="r-void">*** ANULADO ***</div>
        }

        <div class="r-sep"></div>

        <table>
            <thead>
            <tr>
                <th class="col-q">Cant</th>
                <th class="col-p">P. Unit</th>
                <th class="col-t">Importe</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td colspan="3" class="item-name r-bold">@item.ProductName</td>
                </tr>
                <tr>
                    <td class="col-q">@EscPosPrinter.FormatQuantity(item.Quantity)</td>
                    <td class="col-p">@c.FormatNumber(item.UnitPrice)</td>
                    <td class="col-t">@c.FormatNumber(item.LineTotal)</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="r-sep"></div>

        <div class="r-totals">
            <div class="r-line"><span>Subtotal</span><span>@c.Format(Model.Subtotal)</span></div>
            @if (Model.DiscountAmount > 0)
            {
                <div class="r-line"><span>Descuento</span><span>-@c.Format(Model.DiscountAmount)</span></div>
            }
            @if (Model.TaxAmount > 0)
            {
                <div class="r-line">
                    <span>@s.TaxName (@s.TaxRate.ToString("0.##")%)</span>
                    <span>@c.Format(Model.TaxAmount)</span>
                </div>
            }

            <div class="r-total"><span>TOTAL</span><span>@c.Format(Model.Total)</span></div>

            <div class="r-line"><span>@EscPosPrinter.PaymentLabel(Model.PaymentMethod)</span>
                <span>@c.Format(Model.AmountReceived)</span></div>
            <div class="r-change"><span>VUELTO</span><span>@c.Format(Model.ChangeGiven)</span></div>
        </div>

        <div class="r-sep"></div>

        <div class="r-center r-shop-info">
            @Model.Items.Count artículos &middot;
            @EscPosPrinter.FormatQuantity(Model.Items.Sum(i => i.Quantity)) unidades
        </div>

        <div class="r-foot">
            @if (!string.IsNullOrWhiteSpace(s.BusinessFooter))
            {
                <div>@s.BusinessFooter</div>
            }
            <div>@Model.SoldAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
        </div>

        @if (copies > 1)
        {
            <div class="r-copy">— @(copy == 1 ? "CLIENTE" : "CONTROL INTERNO") —</div>
        }
    </div>
}

<div class="screen-bar">
    <button type="button" class="primary" onclick="window.print()">Imprimir</button>
    <a href="javascript:window.close()">Cerrar</a>
</div>

<script>
    (function () {
        var auto = @auto.ToString().ToLowerInvariant();
        if (auto) {
            // El punto de venta carga esta página en un marco oculto al cerrar la venta.
            window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 260); });
        }
    })();
</script>
</body>
</html>
