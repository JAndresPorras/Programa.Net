@model ChangePasswordViewModel

<div class="page-head">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>Use una contraseña que solo usted conozca. Mínimo 6 caracteres con al menos un número.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="card-x">
            <div class="card-x__head">
                <svg class="icon" style="color:var(--warning)"><use href="#i-key"></use></svg>
                <h2 class="card-x__title">Nueva contraseña</h2>
            </div>
            <div class="card-x__body">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" data-autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <svg class="icon"><use href="#i-save"></use></svg> Cambiar contraseña
                        </button>
                        <a class="btn btn-soft" asp-action="Profile">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
