@model Category
@{
    var isEdit = Model.Id > 0;
}

<div class="page-head">
    <div>
        <h1>@(isEdit ? "Editar categoría" : "Nueva categoría")</h1>
        <p>El color ayuda a identificar la categoría en el buscador del punto de venta.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn-soft" asp-action="Index">
            <svg class="icon"><use href="#i-back"></use></svg> Volver
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card-x">
            <div class="card-x__body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ej. Panadería" data-autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Color" class="form-label"></label>
                        <div class="d-flex gap-2 align-items-center">
                            <input asp-for="Color" type="color" class="form-control form-control-color"
                                   style="width:64px;height:42px" />
                            <input asp-for="Color" class="form-control num" style="max-width:140px" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentCategoryId" class="form-label">Categoría principal (opcional)</label>
                        <select asp-for="ParentCategoryId" class="form-select">
                            <option value="">— Ninguna: es una categoría principal —</option>
                            @foreach (var parent in (List<Category>)ViewBag.Parents)
                            {
                                <option value="@parent.Id" selected="@(Model.ParentCategoryId == parent.Id)">@parent.Name</option>
                            }
                        </select>
                        <div class="form-hint">Por ejemplo, Yogures y Quesos van dentro de Lácteos.</div>
                        <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3" style="padding:10px 12px 10px 34px;border:1px solid var(--line);border-radius:var(--radius-sm)">
                        <input asp-for="InventoryEnabled" class="form-check-input" />
                        <label asp-for="InventoryEnabled" class="form-check-label"><b>Permite inventario personalizado</b></label>
                        <div class="form-hint">
                            Sus productos se podrán elegir en la vista Inventario. No activa el control
                            de ningún producto por sí solo: usted elige cuáles.
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <svg class="icon"><use href="#i-save"></use></svg> Guardar
                        </button>
                        <a class="btn btn-soft" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mantiene sincronizados el selector de color y el campo de texto.
        (function () {
            var inputs = document.querySelectorAll('[name="Color"]');
            if (inputs.length < 2) { return; }
            inputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    inputs.forEach(function (other) { if (other !== input) { other.value = input.value; } });
                });
            });
        })();
    </script>
}
