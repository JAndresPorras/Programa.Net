@{
    ViewData["Title"] = "Ocurrió un error";
    // Si el error ocurre antes de ingresar no hay menú que mostrar.
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LoginLayout";
}
<div class="page-head">
    <div>
        <h1>Ocurrió un error</h1>
        <p>No pudimos completar la operación. Intente nuevamente o avise al administrador.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card-x">
            <div class="card-x__body text-center py-5">
                <svg class="icon icon-xl mb-3" style="color:var(--danger)"><use href="#i-alert"></use></svg>
                <p class="text-soft">
                    Si el problema se repite, revise el registro del servidor o contacte al soporte del sistema.
                </p>
                <a class="btn btn-primary" asp-controller="Pos" asp-action="Index">
                    <svg class="icon"><use href="#i-back"></use></svg> Volver al punto de venta
                </a>
            </div>
        </div>
    </div>
</div>
