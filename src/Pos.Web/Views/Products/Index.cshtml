@model ProductIndexViewModel
@{
    var c = (CurrencyInfo)ViewBag.Currency;
}

<div class="page-head">
    <div>
        <h1>Maestro de códigos de barras</h1>
        <p>Cada código escaneado por la pistola se resuelve aquí: categoría, código, nombre, precio e imagen.</p>
    </div>
    <div class="page-head__actions">
        @if (User.HasPermission(Permissions.ProductsCreate))
        {
            <a class="btn btn-primary" asp-action="Create">
                <svg class="icon"><use href="#i-plus"></use></svg> Nuevo producto
            </a>
        }
    </div>
</div>

<div class="card-x mb-3">
    <div class="card-x__body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="term">Buscar</label>
                <input type="text" class="form-control" id="term" name="term" value="@Model.Term"
                       placeholder="Nombre, código de producto o código de barras" data-autofocus />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="categoryId">Categoría</label>
                <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">Todas</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="onlyLowStock" name="onlyLowStock"
                           value="true" checked="@Model.OnlyLowStock" />
                    <label class="form-check-label fs-13" for="onlyLowStock">Stock bajo</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="onlyInactive" name="onlyInactive"
                           value="true" checked="@Model.OnlyInactive" />
                    <label class="form-check-label fs-13" for="onlyInactive">Ver desactivados</label>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <svg class="icon"><use href="#i-search"></use></svg> Filtrar
                </button>
                <a class="btn btn-soft" asp-action="Index">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card-x">
    <div class="card-x__head">
        <svg class="icon" style="color:var(--primary)"><use href="#i-box"></use></svg>
        <h2 class="card-x__title">Productos</h2>
        <span class="chip ms-auto">@Model.TotalCount registrados</span>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="empty">
            <svg class="icon"><use href="#i-box"></use></svg>
            <p>No hay productos que coincidan con el filtro.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-x">
                <thead>
                <tr>
                    <th style="width:52px"></th>
                    <th>Producto</th>
                    <th>Códigos de barras</th>
                    <th>Categoría</th>
                    <th class="t-right">Precio</th>
                    <th class="t-center">Stock</th>
                    <th class="t-center">Estado</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@p.Name" class="thumb" />
                            }
                            else
                            {
                                <span class="thumb thumb--ph"><svg class="icon"><use href="#i-image"></use></svg></span>
                            }
                        </td>
                        <td>
                            <b>@p.Name</b>
                            <div class="fs-11 text-muted-x num">@p.Code &middot; @p.Unit</div>
                        </td>
                        <td>
                            @foreach (var b in p.Barcodes.OrderByDescending(x => x.IsPrimary).Take(3))
                            {
                                <span class="chip @(b.IsPrimary ? "chip--primary" : "") num me-1">@b.Code</span>
                            }
                            @if (p.Barcodes.Count > 3)
                            {
                                <span class="fs-11 text-muted-x">+@(p.Barcodes.Count - 3)</span>
                            }
                        </td>
                        <td>
                            <span class="d-inline-flex align-items-center gap-2">
                                <span class="cat-dot" style="background:@(p.Category?.Color ?? "#94a3b8")"></span>
                                @p.Category?.Name
                            </span>
                        </td>
                        <td class="t-right money"><b>@c.Format(p.Price)</b></td>
                        <td class="t-center num">
                            @if (p.Stock <= p.MinStock)
                            {
                                <span class="chip chip--warning">@EscPosPrinter.FormatQuantity(p.Stock)</span>
                            }
                            else
                            {
                                @EscPosPrinter.FormatQuantity(p.Stock)
                            }
                        </td>
                        <td class="t-center">
                            @if (p.IsActive)
                            {
                                <span class="chip chip--success chip--dot">Activo</span>
                            }
                            else
                            {
                                <span class="chip chip--danger chip--dot">Inactivo</span>
                            }
                        </td>
                        <td class="t-right" style="white-space:nowrap">
                            <a class="btn btn-soft btn-sm" asp-action="History" asp-route-id="@p.Id"
                               title="Historial de precios">
                                <svg class="icon"><use href="#i-history"></use></svg>
                            </a>
                            @if (User.HasPermission(Permissions.ProductsEdit))
                            {
                                <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@p.Id">
                                    <svg class="icon"><use href="#i-edit"></use></svg>
                                </a>
                            }
                            @if (User.HasPermission(Permissions.ProductsDelete))
                            {
                                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline"
                                      data-confirm="@(p.IsActive ? $"¿Desactivar {p.Name}? Dejará de venderse." : $"¿Activar {p.Name}?")">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-soft btn-sm"
                                            title="@(p.IsActive ? "Desactivar" : "Activar")">
                                        <svg class="icon"><use href="@(p.IsActive ? "#i-x" : "#i-check")"></use></svg>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-x__foot d-flex justify-content-between align-items-center">
                <span class="fs-12 text-muted-x">Página @Model.Page de @Model.TotalPages</span>
                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-soft btn-sm" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-term="@Model.Term" asp-route-categoryId="@Model.CategoryId"
                           asp-route-onlyInactive="@Model.OnlyInactive" asp-route-onlyLowStock="@Model.OnlyLowStock">Anterior</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-soft btn-sm" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-term="@Model.Term" asp-route-categoryId="@Model.CategoryId"
                           asp-route-onlyInactive="@Model.OnlyInactive" asp-route-onlyLowStock="@Model.OnlyLowStock">Siguiente</a>
                    }
                </div>
            </div>
        }
    }
</div>
